# Copie este arquivo para .env e preencha com valores reais (CLAUDE.md, seção 16.3).
# Na Vercel, as mesmas variáveis vão em Settings → Environment Variables.

PORT=3333
# Gere um valor aleatório: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Banco local (computador). Ignorado quando TURSO_DATABASE_URL está preenchida.
DB_PATH=./data/eventos.db

# Banco na nuvem (produção, Vercel). Deixe vazio para usar o arquivo local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Endereço público do site (usado no sitemap e nas redes sociais), ex.: https://eventos-gori.vercel.app
SITE_URL=

# Usuário organizador criado pelo `npm run seed`
ADMIN_NOME=Coordenação
ADMIN_EMAIL=organizador@escola.com
ADMIN_SENHA=

# Opcionais: aparecem na página de contato quando preenchidos
CONTATO_EMAIL=
CONTATO_TELEFONE=
ESCOLA_ENDERECO=
