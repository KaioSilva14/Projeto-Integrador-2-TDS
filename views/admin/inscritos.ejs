<%- include('../partials/header', { titulo: 'Inscritos' }) %>

<a href="/admin/eventos" class="link-voltar">← Eventos</a>

<section class="cabecalho-pagina cabecalho-com-acao">
  <div>
    <span class="categoria"><%= evento.categoria %></span>
    <h1><%= evento.titulo %></h1>
    <p class="subtitulo"><%= formatarData(evento.data_evento) %> · <%= evento.hora_inicio %> · <%= evento.local %></p>
  </div>
  <a href="/admin/eventos/<%= evento.id %>/editar" class="botao botao-secundario">Editar evento</a>
</section>

<ul class="numeros">
  <li><span class="numero"><%= inscritos.length %>/<%= evento.capacidade %></span> inscritos</li>
  <li><span class="numero"><%= presentes %></span> presentes</li>
  <li><span class="numero"><%= inscritos.length - presentes %></span> ausentes</li>
</ul>

<% if (inscritos.length === 0) { %>
  <div class="vazio">
    <p><strong>Ninguém se inscreveu ainda.</strong></p>
    <p>Compartilhe o link do evento: <a href="/eventos/<%= evento.id %>">/eventos/<%= evento.id %></a></p>
  </div>
<% } else { %>
  <div class="tabela-rolagem">
    <table class="tabela">
      <thead>
        <tr>
          <th scope="col">Aluno</th>
          <th scope="col">Presença</th>
          <th scope="col">Inscrito em</th>
          <th scope="col"><span class="visualmente-oculto">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <% inscritos.forEach(inscrito => { %>
          <tr id="inscricao-<%= inscrito.id %>" class="<%= inscrito.presenca_confirmada ? 'linha-presente' : '' %>">
            <td>
              <span class="tabela-titulo"><%= inscrito.nome %></span>
              <span class="info"><%= inscrito.turma %> · <%= inscrito.email %></span>
            </td>
            <td>
              <form method="post" action="/admin/inscricoes/<%= inscrito.id %>/presenca">
                <% if (inscrito.presenca_confirmada) { %>
                  <button type="submit" class="botao-presenca presente" aria-label="Desmarcar presença de <%= inscrito.nome %>">✓ Presente</button>
                <% } else { %>
                  <button type="submit" class="botao-presenca" aria-label="Marcar presença de <%= inscrito.nome %>">Marcar presença</button>
                <% } %>
              </form>
            </td>
            <td class="info sem-quebra"><%= formatarDataHora(inscrito.data_inscricao) %></td>
            <td>
              <form method="post" action="/admin/inscricoes/<%= inscrito.id %>/excluir"
                    data-confirmar="Remover a inscrição de <%= inscrito.nome %>? A vaga fica livre para outra pessoa.">
                <button type="submit" class="botao botao-perigo botao-pequeno" aria-label="Remover inscrição de <%= inscrito.nome %>">Remover</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
