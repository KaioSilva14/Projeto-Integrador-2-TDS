<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.titulo ? titulo + ' · ' : '' %>Eventos Escolares</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topo">
    <div class="container topo-conteudo">
      <a href="<%= usuario ? '/admin' : '/' %>" class="marca">Eventos Escolares</a>
      <nav class="menu" aria-label="Menu principal">
        <% if (usuario) {
             const ativo = (inicio) => caminho === inicio || (inicio !== '/admin' && caminho.startsWith(inicio)); %>
          <a href="/admin" <%- ativo('/admin') ? 'aria-current="page"' : '' %>>Painel</a>
          <a href="/admin/eventos" <%- ativo('/admin/eventos') ? 'aria-current="page"' : '' %>>Eventos</a>
          <a href="/admin/categorias" <%- ativo('/admin/categorias') ? 'aria-current="page"' : '' %>>Categorias</a>
          <a href="/">Ver site</a>
          <form method="post" action="/admin/logout" class="form-sair">
            <button type="submit" class="link-botao">Sair</button>
          </form>
        <% } else { %>
          <a href="/admin/login">Área do organizador</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="container">
    <% if (aviso) { %>
      <div class="aviso aviso-<%= aviso.tipo %>" role="status"><%= aviso.texto %></div>
    <% } %>
