<%- include('../partials/header', { titulo: 'Inscrição confirmada', semIndexar: true }) %>
<% const primeiroNome = inscricao.nome.split(' ')[0]; %>

<section class="painel-estreito confirmacao">
  <div class="confirmacao-selo" aria-hidden="true">✓</div>
  <h1>Obrigado, <%= primeiroNome %>!</h1>
  <p class="subtitulo">Sua inscrição está confirmada e sua vaga está garantida.</p>

  <dl class="detalhe-dados">
    <div>
      <dt>Evento</dt>
      <dd><%= evento.titulo %></dd>
    </div>
    <div>
      <dt>Data</dt>
      <dd><%= formatarData(evento.data_evento) %></dd>
    </div>
    <div>
      <dt>Horário</dt>
      <dd><%= evento.hora_inicio %><%= evento.hora_fim ? ' às ' + evento.hora_fim : '' %></dd>
    </div>
    <div>
      <dt>Local</dt>
      <dd><%= evento.local %></dd>
    </div>
  </dl>

  <h2 class="titulo-secao">E agora?</h2>
  <ul class="proximos-passos">
    <li>No dia, é só informar seu nome na entrada — a coordenação marca sua presença.</li>
    <li>Inscrição feita com o e-mail <strong><%= inscricao.email %></strong>.</li>
    <li>Não vai poder ir? <a href="/contato">Avise a coordenação</a> para liberar a vaga para outro colega.</li>
  </ul>

  <div class="acoes acoes-centro">
    <a href="/" class="botao">Ver outros eventos</a>
  </div>
</section>

<%- include('../partials/footer') %>
