<%- include('../partials/header', { titulo: 'Próximos eventos' }) %>

<section class="cabecalho-pagina">
  <h1>Próximos eventos</h1>
  <p class="subtitulo">Escolha um evento e garanta sua vaga. Não precisa criar conta.</p>
</section>

<form method="get" action="/" class="filtro">
  <label for="categoria">Categoria</label>
  <select name="categoria" id="categoria" onchange="this.form.submit()">
    <option value="">Todas</option>
    <% categorias.forEach(c => { %>
      <option value="<%= c.id %>" <%= c.id === categoriaSelecionada ? 'selected' : '' %>><%= c.nome %></option>
    <% }) %>
  </select>
  <noscript><button type="submit" class="botao botao-secundario">Filtrar</button></noscript>
</form>

<% if (eventos.length === 0) { %>
  <div class="vazio">
    <% if (categoriaSelecionada) { %>
      <p><strong>Nenhum evento aberto nesta categoria.</strong></p>
      <p><a href="/">Ver todas as categorias</a></p>
    <% } else { %>
      <p><strong>Nenhum evento aberto no momento.</strong></p>
      <p>Quando a coordenação publicar um evento, ele aparece aqui.</p>
    <% } %>
  </div>
<% } else { %>
  <ul class="lista-eventos">
    <% eventos.forEach(evento => { %>
      <li class="card">
        <a href="/eventos/<%= evento.id %>" class="card-link">
          <span class="categoria"><%= evento.categoria %></span>
          <h2><%= evento.titulo %></h2>
          <p class="info"><%= formatarData(evento.data_evento) %> · <%= evento.hora_inicio %> · <%= evento.local %></p>
          <%- include('../partials/badge-evento', { evento }) %>
        </a>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('../partials/footer') %>
